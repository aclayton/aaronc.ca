# Paths that must never be committed.
#
# This repository is PUBLIC, and `publish = "."` in netlify.toml means everything in
# this directory is also served by the website — so each path below is both left out of
# git and 404-guarded in netlify.toml.

NOTES.md
social/
vesica/

# Noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.swp
